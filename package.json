{
  "name": "agent-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev --hostname 127.0.0.1\" \"tsx watch scripts/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start --hostname 127.0.0.1\" \"tsx scripts/worker.ts\"",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset-demo",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:api": "tsx scripts/api-smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
