# Local demonstration sessions are always disabled when NODE_ENV=production.
DEMO_MODE=true
DATABASE_PATH=./data/agent-market.sqlite
# Optional live provider; absent key selects the deterministic provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_MAX_ROUNDS=3
AGENT_MAX_CALLS=10
AGENT_MAX_TOKENS=600
AGENT_TIMEOUT_MS=20000
AGENT_MODEL_RETRIES=1
